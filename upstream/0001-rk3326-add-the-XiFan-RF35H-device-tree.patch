+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * XiFan RF35H: RK3326, 640x480 MIPI-DSI panel, RK817 PMIC, RK915 Wi-Fi,
+ * two analog sticks on one SARADC channel behind a 4-way mux.
+ *
+ * Derived from the XF35H tree of AURKNIX (https://github.com/AveyondFly),
+ * which describes the same board, with the changes validated on the RF35H by
+ * the lakka-rf35h port (https://github.com/debianita22/lakka-rf35h).
+ */
+
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include "rk3326.dtsi"
+
+/ {
+	model = "XiFan RF35H";
+	compatible = "xifan,rf35h", "rockchip,rk3326";
+
+	aliases {
+		mmc0 = &sdmmc;
+		mmc1 = &emmc;
+		mmc2 = &sdio;
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm1 0 25000 0>;
+		brightness-levels = <
