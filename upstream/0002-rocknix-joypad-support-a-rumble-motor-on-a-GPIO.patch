From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Sun, 4 Oct 2026 15:57:17 +0200
Subject: [PATCH 2/4] rocknix-joypad: support a rumble motor on a GPIO

The XiFan RF35H drives its vibration motor from a plain GPIO, not from a
PWM. The patch lets the singleadc driver take "rumble-gpios" when there
is no "pwm-names": any effect with a non-zero level switches the motor
on, and the rumble_enable attribute, suspend and resume behave as for PWM
motors. Boards with a PWM motor take the same path as before.

Built for RK3326 against Linux 7.2.8 with Batocera's patches: no warnings.

Signed-off-by: Domenico D'Arrigo <d.darrigo@outlook.it>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019W6m4A3E7pevQ1bs91jPmM
---
 ...adc-support-a-rumble-motor-on-a-GPIO.patch | 93 +++++++++++++++++++
 1 file changed, 93 insertions(+)
 create mode 100644 package/batocera/controllers/pads/rocknix-joypad/0001-singleadc-support-a-rumble-motor-on-a-GPIO.patch

diff --git a/package/batocera/controllers/pads/rocknix-joypad/0001-singleadc-support-a-rumble-motor-on-a-GPIO.patch b/package/batocera/controllers/pads/rocknix-joypad/0001-singleadc-support-a-rumble-motor-on-a-GPIO.patch
new file mode 100644
index 0000000..635eb3a
--- /dev/null
+++ b/package/batocera/controllers/pads/rocknix-joypad/0001-singleadc-support-a-rumble-motor-on-a-GPIO.patch
@@ -0,0 +1,93 @@
+From 5a4a179538ec232af1c49da6e335e885d5a5d583 Mon Sep 17 00:00:00 2001
+From: Domenico D'Arrigo <d.darrigo@outlook.it>
+Date: Sun, 4 Oct 2026 15:56:41 +0200
+Subject: [PATCH] singleadc: support a rumble motor on a GPIO
+
+Some RK3326 handhelds (XiFan RF35H/XF35H) drive the vibration motor from
+a plain GPIO instead of a PWM. Describe it with "rumble-gpios" (the
+deprecated "rumble-gpio" spelling is accepted too): with no "pwm-names",
+the rumble setup takes the GPIO, and start/stop switch it on and off.
+The motor has no strength control, so any effect with a non-zero level
+turns it on; the rumble_enable attribute, suspend and resume work as for
+PWM motors.
+
+Signed-off-by: Domenico D'Arrigo <d.darrigo@outlook.it>
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+Claude-Session: https://claude.ai/code/session_019W6m4A3E7pevQ1bs91jPmM
+---
+ rocknix-singleadc-joypad.c | 34 +++++++++++++++++++++++++++++++++-
+ 1 file changed, 33 insertions(+), 1 deletion(-)
+
+diff --git a/rocknix-singleadc-joypad.c b/rocknix-singleadc-joypad.c
+index 988689b..6c401ce 100644
+--- a/rocknix-singleadc-joypad.c
++++ b/rocknix-singleadc-joypad.c
+@@ -197,6 +197,8 @@ struct joypad {
+ 	/* pwm device for rumble*/
+ 	struct input_dev *input;
+ 	struct pwm_device *pwm;
++	/* or a plain on/off motor on a gpio, when there is no pwm */
++	struct gpio_desc *rumble_gpio;
+ 	struct work_struct play_work;
+ 	u16 level;
+ 	u16 boost_weak;
+@@ -236,6 +238,11 @@ static int pwm_vibrator_start(struct joypad *joypad)
+ 	struct pwm_state state;
+ 	int err;
+ 
++	if (joypad->rumble_gpio) {
++		gpiod_set_value_cansleep(joypad->rumble_gpio, 1);
++		return 0;
++	}
++
+ 	pwm_get_state(joypad->pwm, &state);
+ 	pwm_set_relative_duty_cycle(&state, joypad->level, 0xffff);
+ 	state.enabled = true;
+@@ -255,6 +262,11 @@ static int pwm_vibrator_start(struct joypad *joypad)
+ 
+ static void pwm_vibrator_stop(struct joypad *joypad)
+ {
++	if (joypad->rumble_gpio) {
++		gpiod_set_value_cansleep(joypad->rumble_gpio, 0);
++		return;
++	}
++
+ 	pwm_disable(joypad->pwm);
+ }
+ 
+@@ -802,6 +814,24 @@ static int joypad_rumble_setup(struct device *dev, struct joypad *joypad)
+ 	int error;
+ 	struct pwm_state state;
+ 
++	/*
++	 * A motor on a gpio (XiFan RF35H) is either on or off: any effect
++	 * with a non-zero level switches it on.
++	 */
++	if (!device_property_present(dev, "pwm-names")) {
++		joypad->rumble_gpio = devm_gpiod_get(dev, "rumble", GPIOD_OUT_LOW);
++		if (IS_ERR(joypad->rumble_gpio)) {
++			error = PTR_ERR(joypad->rumble_gpio);
++			joypad->rumble_gpio = NULL;
++			dev_err(dev, "failed to request rumble gpio, error: %d\n",
++				error);
++			return error;
++		}
++		INIT_WORK(&joypad->play_work, pwm_vibrator_play_work);
++		dev_info(dev, "rumble setup success (gpio)\n");
++		return 0;
++	}
++
+ 	joypad->pwm = devm_pwm_get(dev, "enable");
+ 	if (IS_ERR(joypad->pwm)) {
+ 		dev_err(dev, "rumble get error\n");
+@@ -1294,7 +1324,9 @@ static int joypad_dt_parse(struct device *dev, struct joypad *joypad)
+ 			joypad->amux_count, joypad->bt_gpio_count);
+ 
+ 	joypad->has_rumble =
+-		device_property_present(dev, "pwm-names");
++		device_property_present(dev, "pwm-names") ||
++		device_property_present(dev, "rumble-gpios") ||
++		device_property_present(dev, "rumble-gpio");
+ 	if (joypad->has_rumble)
+ 		dev_info(dev, "has rumble\n");
+ 
