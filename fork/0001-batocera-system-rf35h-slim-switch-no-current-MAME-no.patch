From 95cdf2709906148f53c2d65f6b1cde63ca6ce76c Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <d.darrigo@outlook.it>
Date: Sun, 4 Oct 2026 16:02:11 +0200
Subject: [PATCH 1/3] batocera-system: rf35h slim switch (no current MAME, no
 Moonlight)

batocera-rf35h only. BR2_PACKAGE_BATOCERA_RF35H_SLIM keeps out the
current MAME (standalone and libretro), too heavy for the RK3326, and
Moonlight with Qt 6: hours of build on the free CI runners for things
the RF35H does not run well.

Signed-off-by: Domenico D'Arrigo <d.darrigo@outlook.it>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019W6m4A3E7pevQ1bs91jPmM
---
 .../batocera/core/batocera-system/Config.in    | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/package/batocera/core/batocera-system/Config.in b/package/batocera/core/batocera-system/Config.in
index 6c876f4..3db6851 100644
--- a/package/batocera/core/batocera-system/Config.in
+++ b/package/batocera/core/batocera-system/Config.in
@@ -1015,7 +1015,7 @@ config BR2_PACKAGE_BATOCERA_GAMESTREAM_SYSTEMS
 
 	# Game streaming
 	select BR2_PACKAGE_MOONLIGHT_EMBEDDED    if !BR2_PACKAGE_WAYLAND && !BR2_PACKAGE_XORG7
-	select BR2_PACKAGE_MOONLIGHT_QT		     if (BR2_PACKAGE_WAYLAND || BR2_PACKAGE_XORG7)
+	select BR2_PACKAGE_MOONLIGHT_QT		     if (BR2_PACKAGE_WAYLAND || BR2_PACKAGE_XORG7) && !BR2_PACKAGE_BATOCERA_RF35H_SLIM
 
 #### ScummVM ####
 config BR2_PACKAGE_BATOCERA_SCUMMVM_SYSTEMS
@@ -1146,12 +1146,14 @@ config BR2_PACKAGE_BATOCERA_ARCADE_SYSTEMS
 	select BR2_PACKAGE_LIBRETRO_IMAME		if BR2_PACKAGE_BATOCERA_TARGET_BCM2835 # IMAME
 	select BR2_PACKAGE_LIBRETRO_MAME		if !BR2_PACKAGE_BATOCERA_TARGET_BCM2835	&& \
 							   !BR2_PACKAGE_BATOCERA_TARGET_H3	&& \
-							   !BR2_PACKAGE_BATOCERA_TARGET_RK3128
+							   !BR2_PACKAGE_BATOCERA_TARGET_RK3128	&& \
+							   !BR2_PACKAGE_BATOCERA_RF35H_SLIM
 	select BR2_PACKAGE_LIBRETRO_SAME_CDI		if BR2_PACKAGE_BATOCERA_TARGET_X86_ANY || \
 	                                               BR2_aarch64
 
 	# Standalone MAME
-	select BR2_PACKAGE_MAME		if BR2_x86_64 || ((BR2_arm || BR2_aarch64 || BR2_RISCV_64) && BR2_PACKAGE_BATOCERA_WAYLAND)
+	select BR2_PACKAGE_MAME		if (BR2_x86_64 || ((BR2_arm || BR2_aarch64 || BR2_RISCV_64) && BR2_PACKAGE_BATOCERA_WAYLAND)) && \
+					   !BR2_PACKAGE_BATOCERA_RF35H_SLIM
 
 	# Namco System246 and System256
 	select BR2_PACKAGE_PCSX2X6    if BR2_PACKAGE_BATOCERA_TARGET_X86_64_ANY
@@ -2018,6 +2020,16 @@ config BR2_PACKAGE_BATOCERA_GUNS
 	select BR2_PACKAGE_ONEHIT_GUNS                          # OneHit light gun
 	select BR2_PACKAGE_LIGHTGUN_CONTROLLERS_ART             # gun images for the bcc
 
+config BR2_PACKAGE_BATOCERA_RF35H_SLIM
+	bool "batocera-rf35h: leaner package set"
+	default n
+	help
+	  batocera-rf35h (XiFan RF35H): leaves out what a 3.5" RK3326
+	  handheld cannot use well and costs hours of build on free CI
+	  runners: the current MAME, standalone and libretro (too heavy
+	  for the RK3326; MAME 2003-Plus stays), and Moonlight (Qt 6, game
+	  streaming over a 2.4 GHz RK915).
+
 config BR2_PACKAGE_BATOCERA_KODI21
 	bool "batocera.linux Kodi 21 packages selection"
 	default n
-- 
